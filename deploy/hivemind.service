# systemd unit template for the Hivemind server.
#
# Placeholders are filled in by `deploy/install-service.sh`, which reads them from the machine it
# runs on. Nothing here is specific to any host, so the file is safe to commit and to fork.
#
#   bash deploy/install-service.sh          # renders this, then installs and enables it
#
# To do it by hand instead, replace __USER__ and __REPO__ below and copy to
# /etc/systemd/system/hivemind.service.
[Unit]
Description=Hivemind server (shared agent knowledge graph + artifacts + tools)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO__
EnvironmentFile=__REPO__/deploy/hivemind.env
ExecStart=__REPO__/.venv/bin/hivemind-server
Restart=on-failure
RestartSec=3
# hardening
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
