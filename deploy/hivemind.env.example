# Copy to deploy/hivemind.env and edit. Loaded by the systemd unit.
# Data lives OUTSIDE the repo and holds one subdir per project (db + blobs + tokens).
HIVEMIND_DATA_DIR=${HOME}/hivemind-data
HIVEMIND_PROJECTS_DIR=${HOME}/hivemind-data/projects
# Bind private interfaces. On a box with no public NIC, 0.0.0.0 covers LAN + Tailscale.
# Otherwise set the specific private addresses. Bearer auth gates every request regardless.
HIVEMIND_HOST=0.0.0.0
HIVEMIND_PORT=8787
# '*' disables the DNS-rebinding host check (fine on a private LAN/mesh). Or list allowed hosts.
HIVEMIND_ALLOWED_HOSTS=*
HIVEMIND_REQUIRE_AUTH=1
# Where backup.sh writes. Point this at a SECOND physical disk if you have one, so a
# backup survives a disk failure and not just an accidental delete.
HIVEMIND_BACKUP_DIR=${HOME}/hivemind-backup
