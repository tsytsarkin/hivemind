# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# uv
# (uv.lock IS committed; caches are not)

# Runtime data — never commit the live DB, blobs, or tokens
hivemind-data/
*.db
*.db-wal
*.db-shm
blobs/
tokens.json
*.token

# OS
.DS_Store

# local dev tooling
.tooling/

# deployment env (environment-specific)
deploy/hivemind.env

# Per-project secrets and token stores must never be committed. A test that constructs a fake
# project directory inside the tree causes register_secret() to write a real HMAC key there; one
# such key reached origin this way. These patterns make that unstageable rather than merely
# discouraged — the durable fix is that tests build project dirs under tmp_path.
bus_secret
tokens.json
identities.json
packages/hivemind-server/tests/_tmp_*/

# documentation is kept outside the repo
docs/
